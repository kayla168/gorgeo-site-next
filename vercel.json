{
  "redirects": [
    {
      "source": "/services/(.*)",
      "destination": "/process/$1",
      "permanent": true
    },
    {
      "source": "/applications/(.*)",
      "destination": "/case-studies/$1",
      "permanent": true
    }
  ],
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ]
}
